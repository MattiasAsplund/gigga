{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "files": { "includes": ["apphost.mts", "services/**/*.{js,jsx,ts,tsx,mts,cts}"] },

  "formatter": { "enabled": true },
  "assist": { "enabled": false },

  // Ett bortglömt await i apphost.mts bygger en halv resursgraf under tystnad. Det är
  // hela anledningen till att det finns en linter i det här repot.
  //
  // noFloatingPromises känner bara igen `Promise`. Aspires byggare returnerar
  // `PromiseLike` och slinker igenom — därför plugin:et, som tar de fallen. Regeln står
  // kvar ändå: den fångar vanliga Promise och kostar ingenting.
  //
  // Regeln ligger i nursery och kan ändras mellan Biome-versioner. Slutar den finnas
  // står plugin:et kvar och gör grovjobbet.
  "plugins": ["./floating-thenables.grit"],
  "linter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["apphost.mts"],
      "linter": {
        "enabled": true,
        "rules": {
          "preset": "none",
          "nursery": { "noFloatingPromises": "error" }
        }
      }
    }
  ]
}
