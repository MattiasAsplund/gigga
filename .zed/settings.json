{
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": [
            "x",
            "biome",
            "format",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
