{
  "name": "@fastgig/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "set -o pipefail; mkdir -p coverage && bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage 2>&1 | tee coverage/summary.txt",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "^4.0.6",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.0",
    "fflate": "^0.8.3",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
