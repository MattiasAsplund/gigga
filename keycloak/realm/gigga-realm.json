{
  "realm": "gigga",
  "displayName": "gigga",
  "enabled": true,
  "sslRequired": "none",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@gigga.dev",
    "fromDisplayName": "gigga",
    "auth": "",
    "ssl": "",
    "starttls": ""
  },
  "clients": [
    {
      "clientId": "gigga-web",
      "name": "gigga webb",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "organization"
      ],
      "protocolMappers": [
        {
          "name": "gigga-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gigga-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "gigga-api",
      "name": "gigga API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "identityProviders": [
    {
      "alias": "folkid",
      "displayName": "FolkID",
      "providerId": "oidc",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "gigga",
        "clientSecret": "gigga-folkid-dev-secret",
        "authorizationUrl": "http://localhost:3005/oidc/authorize",
        "tokenUrl": "http://folkid:3005/oidc/token",
        "jwksUrl": "http://folkid:3005/oidc/jwks",
        "userInfoUrl": "http://folkid:3005/oidc/userinfo",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "defaultScope": "openid profile",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "clientAuthMethod": "client_secret_basic",
        "syncMode": "IMPORT"
      }
    }
  ],
  "organizations": [
    {
      "name": "Gigga AB",
