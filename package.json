{
    "name": "fastgig",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["services/*"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "biome lint",
    "typecheck": "tsc --noEmit -p tsconfig.apphost.json",
    "dev": "aspire run",
    "test": "cd services/api && bun test",
    "test:coverage": "cd services/api && bun run test:coverage && cd .. && bun run test:lcoview",
    "test:lcoview": "bun node_modules/lcoview/bin/lcoview.js services/api/coverage/lcov.info -d services/api/coverage -s services/api",
    "marp": "marp -p outputs/flow.marp"
  },
  "dependencies": {
    "lcoview": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vscode-jsonrpc": "^8.2.1"
  }
}
