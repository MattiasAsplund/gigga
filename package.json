{
  "name": "fastgig",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["services/*"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "eslint apphost.mts",
    "typecheck": "tsc --noEmit -p tsconfig.apphost.json",
    "dev": "aspire run",
    "test": "cd services/api && bun test",
    "test:coverage": "cd services/api && bun run test:coverage && bun node_modules/lcoview/bin/lcoview.js coverage/lcov.info -d coverage",
    "test:lcoview": "bun node_modules/lcoview/bin/lcoview.js services/api/coverage/lcov.info -d services/api/coverage -s services/api"
  },
  "dependencies": {
    "lcoview": "^1.1.1",
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
